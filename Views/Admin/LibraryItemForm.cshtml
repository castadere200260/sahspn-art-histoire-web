@model Sahspn.ArtHistoire.Models.LibraryItem
@{
    var isNew = Model.Id <= 0; ViewData["Title"] = isNew ? "Ajouter à la bibliothèque" : "Modifier un élément de la bibliothèque";
}
<section class="section admin-section"><div class="container"><p class="eyebrow">Administration · Bibliothèque</p><h1>@ViewData["Title"]</h1><p class="admin-intro">Les éléments publiés sont visibles et recherchables par tous les visiteurs. Les éléments masqués restent accessibles uniquement à l’administration.</p><form asp-action="SaveLibraryItem" method="post" enctype="multipart/form-data" class="admin-login-form">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id" /><input type="hidden" asp-for="CreatedAtUtc" /><input type="hidden" asp-for="UpdatedAtUtc" /><input type="hidden" asp-for="CoverImage" /><input type="hidden" asp-for="DocumentUrl" /><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="form-field"><label asp-for="Title">Titre</label><input asp-for="Title" maxlength="180" required /><span asp-validation-for="Title" class="field-validation-error"></span></div><div class="form-field"><label asp-for="Author">Auteur</label><input asp-for="Author" maxlength="180" /></div><div class="form-field"><label asp-for="Category">Catégorie / thème</label><input asp-for="Category" maxlength="120" placeholder="Histoire locale, archéologie…" /></div><div class="form-field"><label asp-for="PublicationYear">Année de publication</label><input asp-for="PublicationYear" type="number" min="1000" max="3000" /></div><div class="form-field"><label asp-for="Summary">Résumé</label><textarea asp-for="Summary" rows="3" maxlength="3000"></textarea></div><div class="form-field"><label asp-for="Content">Description détaillée / notes</label><textarea asp-for="Content" rows="8"></textarea></div><div class="form-field"><label for="coverFile">Couverture (JPG, PNG, WebP · 8 Mo max.)</label><input id="coverFile" name="coverFile" type="file" accept=".jpg,.jpeg,.png,.webp" />@if(!string.IsNullOrWhiteSpace(Model.CoverImage)){
<p><a href="@Model.CoverImage" target="_blank" rel="noopener">Voir la couverture actuelle</a></p>
}
</div><div class="form-field"><label for="documentFile">Document PDF (25 Mo max.)</label><input id="documentFile" name="documentFile" type="file" accept=".pdf,application/pdf" />@if(!string.IsNullOrWhiteSpace(Model.DocumentUrl)){
<p><a href="@Model.DocumentUrl" target="_blank" rel="noopener">Ouvrir le document actuel</a></p>
}
</div><div class="form-field"><label asp-for="IsPublished">Publication</label><input asp-for="IsPublished" type="checkbox" /> <span>Visible sur le site public</span></div><div class="form-actions"><button class="button" type="submit">@(isNew ? "Ajouter à la bibliothèque" : "Enregistrer les modifications")</button><a class="button button-secondary" asp-action="Library">Annuler</a></div></form></div></section>
