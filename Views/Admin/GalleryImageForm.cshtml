@model Sahspn.ArtHistoire.Models.GalleryImage
@{
    var isNew = ViewBag.IsNewGalleryImage is bool newValue ? newValue : string.IsNullOrWhiteSpace(Model.Id);
    ViewData["Title"] = isNew ? "Ajouter une image" : "Modifier une image";
}
<section class="section admin-section">
    <div class="container" style="max-width:820px">
        <p class="eyebrow">Administration · Galerie</p>
        <h1>@(isNew ? "Ajouter une image" : "Modifier une image")</h1>
        <form asp-controller="Admin" asp-action="SaveGalleryImage" method="post" enctype="multipart/form-data" class="admin-login-form">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="ImageUrl" type="hidden" />
            <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="gallery-current-image"><img src="@Model.ImageUrl" alt="@(Model.AltText ?? Model.Title)" /><p>Image actuelle</p></div>
            }
            <div class="form-field"><label asp-for="Title">Titre *</label><input asp-for="Title" maxlength="160" required /><span asp-validation-for="Title" class="field-validation-error"></span></div>
            <div class="form-field"><label asp-for="Description">Description</label><textarea asp-for="Description" rows="3" maxlength="500"></textarea><span asp-validation-for="Description" class="field-validation-error"></span></div>
            <div class="form-field"><label for="imageFile">@(isNew ? "Image *" : "Remplacer l’image (facultatif)")</label><input id="imageFile" name="imageFile" type="file" accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" @(isNew ? "required" : null) /><small>JPG, PNG, WEBP ou GIF · 10 Mo maximum.</small></div>
            <div class="form-field"><label asp-for="AltText">Texte alternatif (accessibilité)</label><input asp-for="AltText" maxlength="180" placeholder="Description courte de l’image" /></div>
            <div class="form-field"><label asp-for="DisplayOrder">Ordre d’affichage</label><input asp-for="DisplayOrder" type="number" min="0" max="100000" /></div>
            <label class="checkbox-field"><input asp-for="IsPublished" /> Publier sur le site public</label>
            <div class="form-actions"><button class="button button-dark" type="submit">Enregistrer</button><a class="button" asp-action="Gallery">Annuler</a></div>
        </form>
    </div>
</section>
