@model Sahspn.ArtHistoire.Controllers.AdminDashboardViewModel
@{
    ViewData["Title"] = "Administration";
}
<section class="section">
    <div class="container">
        <p class="eyebrow">Espace privé · SAHSPN</p>
        <h2>Tableau de bord pour gérez les données de l’association.</h2>
        @* <p>Bienvenue, @User.Identity?.Name. Gérez les données de l’association.</p> *@
        <div class="admin-cards">

            <a class="admin-card admin-card-link" asp-action="Bulletins">
                <span class="admin-card-label">Bulletins</span>
                @* <strong>@Model.TotalBulletins</strong> *@
                <p>Créer, modifier et supprimer les bulletins.</p>
                <span class="button">Gérer Bulletins →</span>
            </a>

            <a class="admin-card admin-card-link" asp-action="Library">
                <span class="admin-card-label">Bibliotheque</span>
                <p>Gérer ouvrages et réferences.</p>
                <span class="button">Gérer Bibliotheque →</span>
            </a>

            <a class="admin-card admin-card-link" asp-action="DocumentsStudies">
                <span class="admin-card-label">Documents</span>
                <p>Gérez Documents et études.</p>
                <span class="button">Gérer Documents →</span>
            </a>

            <a class="admin-card admin-card-link" asp-action="Gallery">
                <span class="admin-card-label">Galerie</span>
                <p>Ajouter, modifier, publier et supprimer les photos de l’association.</p>
                <span class="button">Gérer la galerie →</span>
            </a>

            <a class="admin-card admin-card-link" asp-action="Members">
                <span class="admin-card-label">Membres</span>
                @* <strong>@Model.TotalMembers</strong> *@
                <p>Coordonnées et adhésions des membres.</p>
                <span class="button">Gérer Membres →</span>
            </a>

            <a class="admin-card admin-card-link" asp-action="Appointments">
                <span class="admin-card-label">Actualités</span>
                @* <strong>@Model.TotalAppointments</strong> *@
                <p>Réunions, conférences et événements.</p>
                <span class="button">Gérer Actualités →</span>
            </a>

            <a class="admin-card admin-card-link" asp-action="Shop">
                <span class="admin-card-label">Boutique</span>
                <p>Bulletins et documents avec prix.</p>
                <span class="button">Gérer Boutique →</span>
            </a>

            <a class="admin-card admin-card-link" asp-action="Partners">
                <span class="admin-card-label">Partenaires</span>
                <p>Gérer les Partenaires de SAHSPN.</p>
                <span class="button">Gérer Partenaire →</span>
            </a>

            <a class="admin-card admin-card-link" asp-action="Users">
                <span class="admin-card-label">Utilisateurs</span>
                @* <strong>@Model.TotalUsers</strong> *@
                <p>Comptes d’administration et activation.</p>
                <span class="button">Gérer Utilisateurs →</span>
            </a>
        </div>
        @if (TempData["AdminError"] is string error)
        {
            <p class="validation-summary">@error</p>
        }
    </div>
</section>
