@model IReadOnlyList<Sahspn.ArtHistoire.Models.SitePage>
@{
    ViewData["Title"] = "Gestion des pages du site";
}
<section class="section">
    <div class="container">
        <h1>Gestion des pages du site</h1>
        <p>
            <a class="button button-dark" asp-action="NewSitePage">Nouvelle page</a>
            <a class="button button-light" asp-action="Index">Retour tableau de bord</a>
        </p>
        @if (TempData["AdminSuccess"] is string success)
        {
            <p class="success-message">@success</p>
        }
        @if (TempData["AdminError"] is string error)
        {
            <p class="validation-summary">@error</p>
        }
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr><th>Titre</th><th>Adresse (slug)</th><th>Dernière modification</th><th>Actions</th></tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4">Aucune page disponible.</td></tr>
                }
                else
                {
                    @foreach (var sitePage in Model)
                    {
                        <tr>
                            <td>@sitePage.Title</td>
                            <td><a asp-controller="Pages" asp-action="Details" asp-route-slug="@sitePage.Slug" target="_blank" rel="noopener">/@sitePage.Slug</a></td>
                            <td>@sitePage.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a asp-action="EditSitePage" asp-route-slug="@sitePage.Slug">Modifier</a>
                                <form asp-action="DeleteSitePage" asp-route-slug="@sitePage.Slug" method="post" style="display:inline" onsubmit="return confirm('Supprimer cette page ?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="button-link">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
