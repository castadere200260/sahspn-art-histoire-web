@model IReadOnlyList<Sahspn.ArtHistoire.Models.LibraryItem>
@{
    ViewData["Title"] = "Gestion de la bibliothèque";
}
<section class="section">
    <div class="container">
        <h1>Bibliothèque</h1>
        @if (TempData["AdminSuccess"] is string success)
        {
            <p class="admin-success" role="status">@success</p>
        }
        @if (TempData["AdminError"] is string error)
        {
            <p class="validation-summary" role="alert">@error</p>
        }
        <p>
            <a class="button button-dark" asp-action="NewLibraryItem">Ajouter Ouvrage/Ressource</a> 
            <a class="button button-light" asp-action="Index">Retour tableau de bord</a>
        </p>
        @if (Model.Count == 0)
        {
            <div class="admin-empty-state">Aucun élément dans la bibliothèque.</div>
        }
        else
        {

            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>Titre</th><th>Auteur</th><th>Catégorie</th><th>Année</th><th>Visibilité</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr><td>@item.Title</td><td>@(item.Author ?? "—")</td><td>@(item.Category ?? "—")</td><td>@(item.PublicationYear?.ToString() ?? "—")</td><td>@(item.IsPublished ? "Publié" : "Masqué")</td><td><a asp-action="EditLibraryItem" asp-route-id="@item.Id">Modifier</a> <form asp-action="DeleteLibraryItem" asp-route-id="@item.Id" method="post" class="inline-form" onsubmit="return confirm('Supprimer cet élément de la bibliothèque ?')">@Html.AntiForgeryToken()<button type="submit" class="text-danger">Supprimer</button></form></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
