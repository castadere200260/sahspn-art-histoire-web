@model IReadOnlyList<Sahspn.ArtHistoire.Models.Bulletin>
@{
    ViewData["Title"] = "Gestion des bulletins";
}
<section class="section">
    <div class="container">
        <p class="eyebrow">Administration</p><h1>Gestion des bulletins</h1>@if (TempData["AdminSuccess"] is string success){
        <p class="admin-success" role="status">@success</p>
                }
        @if (TempData["AdminError"] is string error)
        {
            <p class="validation-summary" role="alert">@error</p>
        }
        <p>
            <a class="button" asp-action="NewBulletin">+ Nouveau bulletin</a> <a asp-action="Index">Retour au tableau de bord</a>
        </p>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>N°</th><th>Titre</th><th>Publication</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var x in Model)
                    {
                        <tr><td>@x.Number</td><td>@x.Title</td><td>@(x.PublishedAt?.ToString("dd/MM/yyyy") ?? "—")</td><td><a asp-action="EditBulletin" asp-route-number="@x.Number">Modifier</a><form asp-action="DeleteBulletin" asp-route-number="@x.Number" method="post" class="inline-form" onsubmit="return confirm('Supprimer ce bulletin ?')">@Html.AntiForgeryToken()<button type="submit" class="text-danger">Supprimer</button></form></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
