@model IReadOnlyList<Sahspn.ArtHistoire.Models.Partner>
@{
    ViewData["Title"] = "Gestion des partenaires";
}
<section class="section">
    <div class="container">
        <p class="eyebrow">Administration · Partenaires</p><h1>Gestion des partenaires</h1>
        @if (TempData["AdminSuccess"] is string success)
        {
            <p class="admin-success" role="status">@success</p>
        }
        @if (TempData["AdminError"] is string error)
        {
            <p class="validation-summary" role="alert">@error</p>
        }
        <p>
            <a class="button button-dark" asp-action="NewPartner">+ Ajouter un partenaire</a>
            <a asp-controller="PublicDirectory" asp-action="Partners" target="_blank" rel="noopener">Voir la page publique ↗</a>
        </p>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Partenaire</th><th>Ordre</th><th>Visibilité</th><th>Actions</th></tr></thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="4" class="admin-empty-state">Aucun partenaire enregistré.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Name</strong>@if (!string.IsNullOrWhiteSpace(item.WebsiteUrl)) {
                                <div><a href="@item.WebsiteUrl" target="_blank" rel="noopener noreferrer">Site web ↗</a></div>
                            }
                            <div class="admin-muted">@item.Description</div>
                        </td>
                        <td>@item.DisplayOrder</td>
                        <td><span class="admin-status @(item.IsPublished ? "is-active" : "is-inactive")">@(item.IsPublished ? "Publié" : "Masqué")</span></td>
                        <td><a asp-action="EditPartner" asp-route-id="@item.Id">Modifier</a><form asp-action="DeletePartner" asp-route-id="@item.Id" method="post" class="inline-form" onsubmit="return confirm('Supprimer ce partenaire ?')">@Html.AntiForgeryToken()<button type="submit" class="text-danger">Supprimer</button></form></td>
                    </tr>
                                        }
                </tbody>
            </table>
        </div>
    </div>
</section>
