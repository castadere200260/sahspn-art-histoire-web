@model IReadOnlyList<Sahspn.ArtHistoire.Models.Member>
@{
    ViewData["Title"] = "Membres du bureau";
}
<section class="section">
    <div class="container">
        <p class="eyebrow">Administration · Bureau</p>
        <div class="admin-page-heading">
            <div>
                <h1>Membres du bureau</h1>
                <p>Seuls les membres identifiés comme membres du bureau sont affichés.</p>
            </div>
            <a class="button button-dark" asp-action="Members">Tous les membres</a>
        </div>
        <p class="admin-list-count">@Model.Count membre(s) du bureau</p>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Nom</th><th>Poste</th><th>Date d’élection</th><th>Statut</th><th>Actions</th></tr></thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="5" class="admin-empty-state">Aucun membre du bureau n’est défini. Modifiez une fiche membre pour l’ajouter au bureau.</td></tr>
                    }
                    else
                    {
                        @foreach (var member in Model)
                        {
                            <tr><td><strong>@member.FullName</strong></td><td>@(string.IsNullOrWhiteSpace(member.BoardPosition) ? "—" : member.BoardPosition)</td><td>@(member.ElectionDate?.ToString("dd/MM/yyyy") ?? "—")</td><td><span class="admin-status @(member.IsActive ? "is-active" : "is-inactive")">@(member.IsActive ? "Actif" : "Inactif")</span></td><td class="admin-actions"><a asp-action="EditMember" asp-route-id="@member.Id">Modifier</a></td></tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
