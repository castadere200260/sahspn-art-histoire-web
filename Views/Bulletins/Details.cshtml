@model Bulletin
@{
    ViewData["Title"] = Model.Title;
}
<section class="page-hero compact-hero">
    <div class="container">
        <h1>@Model.Title</h1>
        <p>
            <a class="button button-dark" asp-action="Index">← Retour aux bulletins</a>
        </p>
    </div>
</section>
<section class="page-content">
    <div class="container bulletin-detail">
        <div class="detail-cover">
            @if (!string.IsNullOrWhiteSpace(Model.CoverImage))
            {
                <img src="@Model.CoverImage" alt="Couverture du bulletin @Model.Number" />
            }
            else
            {

                <div class="cover-placeholder large-placeholder"><span>ART & HISTOIRE</span><strong>PÉRIGORD<br>NOIR</strong><small>Bulletin n° @Model.Number</small></div>
            }
        </div>
        <div class="detail-copy">
            <div class="content-kicker">SOMMAIRE & EXTRAITS</div>
            <div class="legacy-content">@Model.Content</div>
            <p class="muted-note">Pour obtenir un exemplaire ou vérifier la disponibilité d’un numéro, contactez l’association.</p><a class="button button-dark" asp-controller="Pages" asp-action="Contact">Demander des informations <span>↗</span></a>
        </div>
    </div>
</section>
