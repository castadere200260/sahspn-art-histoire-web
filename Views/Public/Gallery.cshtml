@model IReadOnlyList<Sahspn.ArtHistoire.Models.GalleryImage>

@{
    ViewData["Title"] = "Galerie photos";
}

<section class="section">
    <div class="container">
        <div class="admin-page-heading">
            <div>
                <h1>Galerie</h1>
                <p>Quelques images de la vie de l’association, de ses activités et du patrimoine du Périgord Noir.</p>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="admin-empty-state">
                La galerie sera bientôt enrichie de nouvelles photographies.
            </div>
        }

        <div class="gallery-grid">
            @foreach (var item in Model)
            {
                <figure class="gallery-card public-gallery-card">
                    <img class="gallery-zoom-image"
                         src="@Url.Content(item.ImageUrl)"
                         alt="@(item.AltText ?? item.Title)"
                         loading="lazy"
                         onclick="openCoverZoom(this.src)" />

                    <button type="button"
                            class="button"
                            onclick="openCoverZoom('@Url.Content(item.ImageUrl)')">
                        Agrandir l’image
                    </button>

                    <figcaption class="gallery-card-body">
                        <h2>@item.Title</h2>

                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p>@item.Description</p>
                        }
                    </figcaption>
                </figure>
            }
        </div>

        <br />
    </div>
</section>

<div id="coverZoomModal"
     class="cover-zoom-modal"
     onclick="closeCoverZoom()"
     style="display:none;">

    <button type="button"
            class="cover-zoom-close"
            aria-label="Fermer"
            onclick="event.stopPropagation(); closeCoverZoom();">
        &times;
    </button>

    <img id="coverZoomImage" alt="Image agrandie" />
</div>

<script>
    function openCoverZoom(imageUrl) {
        document.getElementById('coverZoomImage').src = imageUrl;
        document.getElementById('coverZoomModal').style.display = 'flex';
    }

    function closeCoverZoom() {
        document.getElementById('coverZoomModal').style.display = 'none';
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeCoverZoom();
        }
    });
</script>


