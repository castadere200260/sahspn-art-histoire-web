@model IReadOnlyList<Sahspn.ArtHistoire.Models.Member>
@{
    ViewData["Title"] = "Membres";
}
<section class="section">
    <div class="container">
        <p class="eyebrow">L’association · Annuaire public</p>
        <div class="admin-page-heading">
            <div>
                <h1>Membres de la Société d’Art et d’Histoire de Sarlat et du Périgord Noir.</h1>
            </div>
        </div>
        @* <p class="admin-list-count">@Model.Count membre(s)</p> *@
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead><tr><th>Nom</th><th>Date d’adhésion</th><th>Statut</th></tr></thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="3" class="admin-empty-state">Aucun membre à afficher.</td></tr>
                }
                else
                {
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td><strong>@member.FullName</strong></td>
                            <td>@(member.JoinedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td><span class="admin-status @(member.IsActive ? "is-active" : "is-inactive")">@(member.IsActive ? "Actif" : "Inactif")</span></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <p class="admin-muted">Pour préserver la vie privée des membres, les coordonnées personnelles ne sont pas publiées sur cette page.</p>
    </div>
</section>
