@model IReadOnlyList<Sahspn.ArtHistoire.Models.DocumentStudy>
@{
    ViewData["Title"] = "Documents et études";
}
<section class="page-hero" style="padding:14px">
    >
    <div class="container">
        <h1>Documents <em>& Études.</em></h1>
        <p>Parcourez les documents historiques et les études.</p>
        <form class="search-form" method="get" action="/documents-etudes"><input name="q" value="@ViewBag.Query" placeholder="Rechercher un titre, un sujet, un contenu…" aria-label="Rechercher dans les documents et études" /><button type="submit">Rechercher <span>→</span></button></form>
    </div>
</section>
<section class="catalog-section">
    <div class="container">
        <div class="catalog-heading"><span>@ViewBag.Total document(s) et étude(s)</span><span>Les publications les plus récentes en premier</span></div>
        @if (Model.Count == 0)
        {
            <div class="admin-empty-state">Aucun résultat. Essayez un autre terme de recherche.</div>
        }
        <div class="bulletin-grid catalog-grid">
            @foreach (var item in Model)
            {
                <a class="bulletin-card" asp-controller="PublicDirectory" asp-action="DocumentStudyDetails" asp-route-id="@item.Id">



                    @if (!string.IsNullOrWhiteSpace(item.CoverImage))
                    {
                        <div class="cover-wrap">


                            <img src="@item.CoverImage" alt="Couverture : @item.Title" loading="lazy" />

                        </div>

                    }
           

                    <div class="bulletin-meta">@(item.Type == Sahspn.ArtHistoire.Models.DocumentStudyType.Document ? "DOCUMENT" : "ÉTUDE") <span>@(item.PublishedAt?.ToString("yyyy") ?? "")</span></div><h3>@item.Title</h3>@if(!string.IsNullOrWhiteSpace(item.Summary)){
                    <p>@item.Summary</p>
                }
                <span class="card-link">Consulter <span>→</span></span>
            </a>
                        }
        </div>
        @if ((long)ViewBag.Total > 12)
        {
            <nav class="pagination" aria-label="Pagination">
                @if ((int)ViewBag.Page > 1)
                {
                    <a asp-route-page="@((int)ViewBag.Page - 1)" asp-route-q="@ViewBag.Query">← Précédent</a>
                }
                <span>Page @ViewBag.Page</span>@if((int)ViewBag.Page*12 < (long)ViewBag.Total){
                <a asp-route-page="@((int)ViewBag.Page + 1)" asp-route-q="@ViewBag.Query">Suivant →</a>
            }
        </nav>
                }
    </div>
</section>
