@model ContactMessage
@{
    ViewData["Title"] = "Contact";
}
<section class="page-hero" style="padding:14px">
    <div class="container">
        <h1>Restons <em>en contact.</em></h1>
        <p>Une question sur l’association, les publications ? Écrivez-nous.</p>
        <h3>
            Société d'Art et d'Histoire de Sarlat et du Périgord Noir -BP 47 - 24201 SARLAT Cedex
        </h3>
    </div>
</section>


<section class="page-content">
    <div class="container contact-layout">
        <div class="contact-aside">
            <h2>Une passion commune pour le Périgord Noir.</h2>
            <p>Nous serons heureux d’échanger avec vous au sujet de nos activités, des bulletins et de l’adhésion.</p>
        </div><div class="contact-form-wrap">
            @if (ViewBag.Sent == true)
            {
                <div class="success-message"><strong>Merci pour votre message.</strong
                ><p>Votre demande a bien été enregistrée.</p></div>
            }
            <form asp-action="Contact" method="post" class="contact-form">
                <div asp-validation-summary="ModelOnly" class="validation"></div>
                <label asp-for="Name">Nom et prénom</label>
                <input asp-for="Name" autocomplete="name" /><span asp-validation-for="Name" class="validation"></span>
                <label asp-for="Email">Adresse e-mail</label>
                <input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email" class="validation"></span>
                <label asp-for="Subject">Sujet</label>
                <input asp-for="Subject" /><span asp-validation-for="Subject" class="validation"></span>
                <label asp-for="Message">Votre message</label>
                <textarea asp-for="Message" rows="5"></textarea><span asp-validation-for="Message" class="validation"></span>
                <button class="button button-dark" type="submit">
                    Envoyer le message <span>↗</span>
                </button>
                <small>Ce formulaire enregistre la demande dans la base de données du site.</small>
            </form>
        </div>
    </div>
</section>
